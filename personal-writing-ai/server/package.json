{
  "name": "personal-ai",
  "version": "1.0.0",
  "description": "A personal ai assistant for my assignments",
  "license": "ISC",
  "author": "Adebis Tosin",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "build": "tsc",
    "copy-assets": "cpx --watch \"src/helpers/templates/**/*\" \"dist/src/helpers/templates\"",
    "dev": "concurrently \"tsc -w\" \"nodemon dist/src/server.js\"",
    "new": "ts-node src/server.ts",
    "start:prod": "node dist/src/server.js"
  },
  "dependencies": {
    "@tavily/ai-sdk": "^0.5.0",
    "ai": "^7.0.93",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "mammoth": "^1.12.2",
    "mongoose": "^9.7.4",
    "ollama-ai-provider-v2": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mongoose": "^5.11.96",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
